PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/faithful_cms
# Optional: comma-separated DNS for MongoDB Atlas SRV on Windows (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080
# Same mode for both: test Key Id (rzp_test_…) + test Key Secret from Razorpay Dashboard → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
