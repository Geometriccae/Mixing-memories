# Frontend environment variables (Vite).
# Vite only exposes variables to browser code if they start with `VITE_`.

# --- AUTOMATIC API DETECTION ---
# The app automatically switches to localhost if running on 'localhost' or '127.0.0.1'.
# Otherwise, it uses the production URL below.

# Production URL
VITE_API_BASE_URL=https://backend.theroyaloven.com

# Local URL (Used automatically when on localhost)
VITE_LOCAL_API_BASE_URL=http://localhost:5000
